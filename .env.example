# Copy to .env and adjust. Every value has a working local default.

# --- LLMs (Ollama) -----------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
SQLRAG_LLM_PROVIDER=ollama            # ollama | openai (any OpenAI-compatible endpoint)
SQLRAG_GENERATOR_MODEL=llama3.2:3b     # README default in harness/run.py is qwen2.5:7b
SQLRAG_JUDGE_MODEL=qwen2.5:3b
SQLRAG_TEMPERATURE=0
SQLRAG_SEED=42
SQLRAG_NUM_CTX=8192
SQLRAG_NUM_PREDICT=1024
SQLRAG_NUM_GPU=-1                      # 99 forces full GPU offload (helps on 4 GB GPUs)
SQLRAG_REQUEST_TIMEOUT=240
# SQLRAG_OPENAI_BASE_URL=https://api.openai.com/v1
# SQLRAG_OPENAI_API_KEY=

# --- Embeddings and index --------------------------------------------------------
SQLRAG_EMBEDDING_BACKEND=sentence-transformers   # sentence-transformers | hash (tests) | ollama
SQLRAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
SQLRAG_EMBEDDING_DEVICE=cpu
SQLRAG_STORE_DIR=rag_store
SQLRAG_CHUNK_SIZE=300
SQLRAG_CHUNK_OVERLAP=60
SQLRAG_MIN_CHUNK_TOKENS=60

# --- Retrieval ---------------------------------------------------------------------
SQLRAG_RETRIEVAL_MODE=hybrid          # hybrid | dense | bm25
SQLRAG_TOP_K=4
SQLRAG_CANDIDATES=20
SQLRAG_RRF_K=60
SQLRAG_MIN_SIMILARITY=0.45
SQLRAG_MAX_CONTEXT_TOKENS=1200
SQLRAG_FILL_CONTEXT=0                 # 0 = one covering passage per feature (v4 "focused"); 1 = fill to top_k (v3)
SQLRAG_RAG_PROMPT=prompts/v4_rag.md    # prompts/v3_rag.md reproduces the first RAG experiment

# --- Grounding policy --------------------------------------------------------------
SQLRAG_GROUNDING_POLICY=abstain       # abstain | fallback | off
SQLRAG_MIN_FEATURE_COVERAGE=1.0

# --- API -------------------------------------------------------------------------------
SQLRAG_ADMIN_TOKEN=                   # set to require X-Admin-Token on ingest/delete/labels
SQLRAG_ALLOW_INGEST=1
SQLRAG_MAX_UPLOAD_MB=10
SQLRAG_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- docker compose only -------------------------------------------------------------
APP_PORT=8000
OLLAMA_PORT=11434
